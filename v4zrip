def log_ok(msg):   print(f" {G}[+]{RS} {msg}")
def log_info(msg): print(f" {C}[*]{RS} {D}{msg}{RS}")
def log_warn(msg): print(f" {Y}[!]{RS} {msg}")
def log_err(msg):  print(f" {R}[-]{RS} {msg}")


def norm_url(url):
    """Normalize: drop fragment, keep everything else."""
    return urllib.parse.urldefrag(url)[0]


def is_http(url):
    return urllib.parse.urlparse(url).scheme in ("http", "https")


def safe_name(url, kind):
    """Build a collision-safe local filename for an asset URL."""
    p = urllib.parse.urlparse(url)
    base = os.path.basename(p.path) or "file"
    base = re.sub(r"[^A-Za-z0-9._-]", "_", base)
    stem, ext = os.path.splitext(base)
    if not ext or len(ext) > 6:
        ext = {  # guess from kind
            "images": ".img", "css": ".css", "js": ".js",
            "fonts": ".font", "media": ".bin",
        }.get(kind, ".bin")
        stem = base
    tag = hashlib.md5(url.encode()).hexdigest()[:6]
    stem = (stem[:40] or "file")
    return f"{stem}_{tag}{ext}"


class PageParser(html.parser.HTMLParser):
    """Collect page links, assets and forms from one HTML page."""

    def __init__(self, base_url):
        super().__init__(convert_charrefs=True)
        self.base = base_url
        self.page_links = set()
        self.assets = {}          # abs url -> kind
        self.forms = []
        self._form = None

    def _abs(self, value):
        if not value:
            return None
        value = value.strip()
        if not value or value.startswith(
                ("#", "javascript:", "mailto:", "tel:", "data:", "blob:")):
            return None
        try:
            return norm_url(urllib.parse.urljoin(self.base, value))
        except Exception:
            return None

    def _asset(self, value, kind):
        u = self._abs(value)
        if u and is_http(u):
            self.assets.setdefault(u, kind)

    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if tag == "a":
            u = self._abs(d.get("href", ""))
            if u and is_http(u):
                self.page_links.add(u)
        elif tag == "link":
            rel = d.get("rel", "")
            if "stylesheet" in rel:
                self._asset(d.get("href", ""), "css")
            elif "icon" in rel or "apple-touch-icon" in rel:
                self._asset(d.get("href", ""), "images")
        elif tag == "script":
            self._asset(d.get("src", ""), "js")
        elif tag == "img":
            self._asset(d.get("src", ""), "images")
            for part in d.get("srcset", "").split(","):
                bits = part.strip().split()
                if bits:
                    self._asset(bits[0], "images")
        elif tag in ("source", "video", "audio"):
            self._asset(d.get("src", ""), "media")
            for part in d.get("srcset", "").split(","):
                bits = part.strip().split()
                if bits:
                    self._asset(bits[0], "images")
        elif tag == "embed":
            self._asset(d.get("src", ""), "media")
        elif tag == "form":
            self._form = {
                "action": d.get("action", ""),
                "method": d.get("method", "GET").upper(),
                "inputs": [],
            }
        elif tag == "input" and self._form is not None:
            self._form["inputs"].append({
                "name": d.get("name", ""),
                "type": d.get("type", "text"),
            })
        # inline style="background-image: url(...)"
        style = d.get("style", "")
        if style and "url(" in style:
            for m in re.finditer(r"url\(\s*[\"']?([^\"')\s]+)", style):
                v = m.group(1)
                if v.lower().endswith((".woff", ".woff2", ".ttf", ".otf", ".eot")):
                    self._asset(v, "fonts")
                else:
                    self._asset(v, "images")

    def handle_endtag(self, tag):
        if tag == "form" and self._form is not None:
            self.forms.append(self._form)
            self._form = None


def fetch(url, binary=False):
    """GET a URL. Returns dict with ok/text/raw/status/ct/server."""
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            raw = resp.read()
            ct = resp.headers.get("Content-Type", "")
            if resp.headers.get("Content-Encoding", "") == "gzip":
                try:
                    raw = gzip.decompress(raw)
                except Exception:
                    pass
            out = {"ok": True, "raw": raw, "status": resp.status,
                   "url": resp.geturl(), "ct": ct,
                   "server": resp.headers.get("Server", "Unknown")}
            if not binary:
                charset = "utf-8"
                if "charset=" in ct:
                    charset = ct.split("charset=")[-1].split(";")[0].strip()
                try:
                    out["text"] = raw.decode(charset, errors="replace")
                except Exception:
                    out["text"] = raw.decode("utf-8", errors="replace")
            return out
    except urllib.error.HTTPError as e:
        return {"ok": False, "status": e.code, "error": str(e)}
    except urllib.error.URLError as e:
        return {"ok": False, "status": 0, "error": str(e.reason)}
    except socket.timeout:
        return {"ok": False, "status": 0, "error": "Timeout"}
    except Exception as e:
        return {"ok": False, "status": -1, "error": str(e)}


ATTR_RE = re.compile(
    r'''(?i)\b(href|src|srcset|data-src|poster)\s*=\s*(["'])(.*?)\2''')
CSS_URL_RE = re.compile(r"""url\(\s*["']?([^"')\s]+)["']?\s*\)""")


def resolve_ref(base, value):
    value = value.strip()
    if not value or value.startswith(
            ("#", "javascript:", "mailto:", "tel:", "data:", "blob:")):
        return None
    try:
        u = norm_url(urllib.parse.urljoin(base, value))
    except Exception:
        return None
    return u if is_http(u) else None


def rewrite_html(html, page_url, local_map):
    def rep_attr(m):
        attr, q, val = m.group(1), m.group(2), m.group(3)
        if attr.lower() == "srcset":
            parts = []
            for piece in val.split(","):
                piece = piece.strip()
                if not piece:
                    continue
                bits = piece.split()
                u = resolve_ref(page_url, bits[0])
                if u and u in local_map:
                    bits[0] = local_map[u]
                parts.append(" ".join(bits))
            return f"{attr}={q}{', '.join(parts)}{q}"
        u = resolve_ref(page_url, val)
        if u and u in local_map:
            return f"{attr}={q}{local_map[u]}{q}"
        return m.group(0)

    html = ATTR_RE.sub(rep_attr, html)

    def rep_css(m):
        u = resolve_ref(page_url, m.group(1))
        if u and u in local_map:
            return f"url({local_map[u]})"
        return m.group(0)

    return CSS_URL_RE.sub(rep_css, html)


def rewrite_css(css, css_url, local_map):
    def rep(m):
        u = resolve_ref(css_url, m.group(1))
        if u and u in local_map:
            return f"url({local_map[u]})"
        return m.group(0)

    return CSS_URL_RE.sub(rep, css)


class Ripper:
    def __init__(self, start_url, out_dir, max_depth=1, max_pages=20,
                 threads=8, quiet=False):
        self.start_url = start_url
        self.host = urllib.parse.urlparse(start_url).netloc
        self.out_dir = out_dir
        self.max_depth = max_depth
        self.max_pages = max_pages
        self.threads = threads
        self.quiet = quiet
        self.seen = set()
        self.lock = threading.Lock()
        self.stats = {"pages": 0, "assets": 0, "bytes": 0,
                      "forms": 0, "skipped_robots": 0, "kinds": {}}
        self.disallowed = []
        self._load_robots()

    def say(self, msg):
        if not self.quiet:
            print(msg)

    # ----- robots.txt (basic, good-faith) -----
    def _load_robots(self):
        robots_url = f"{urllib.parse.urlparse(self.start_url).scheme}://{self.host}/robots.txt"
        r = fetch(robots_url)
        if r["ok"] and r["status"] == 200:
            for line in r["text"].splitlines():
                line = line.strip()
                if line.lower().startswith("disallow:"):
                    path = line.split(":", 1)[1].strip()
                    if path:
                        self.disallowed.append(path)
            if self.disallowed:
                log_info(f"robots.txt: respecting {len(self.disallowed)} disallow rule(s)")

    def _allowed(self, url):
        path = urllib.parse.urlparse(url).path or "/"
        for d in self.disallowed:
            if path.startswith(d):
                return False
        return True

    # ----- paths -----
    def page_path(self, url):
        p = urllib.parse.urlparse(url)
        path = p.path or "/"
        if path.endswith("/"):
            rel = path.lstrip("/") + "index.html"
        else:
            rel = path.lstrip("/")
            if "." not in os.path.basename(rel):
                rel += ".html"
        if p.query:
            tag = hashlib.md5(p.query.encode()).hexdigest()[:6]
            stem, ext = os.path.splitext(rel)
            rel = f"{stem}_{tag}{ext}"
        return os.path.join(self.out_dir, "site", rel.lstrip("/"))

    def asset_path(self, url, kind):
        folder = {"css": "css", "js": "js", "images": "images",
                  "fonts": "fonts", "media": "media"}.get(kind, "other")
        return os.path.join(self.out_dir, "assets", folder,
                            safe_name(url, kind))

    # ----- download -----
    def download_asset(self, url, kind):
        dest = self.asset_path(url, kind)
        if os.path.exists(dest):
            return dest, 0
        r = fetch(url, binary=True)
        if not r["ok"]:
            return None, 0
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        data = r["raw"]
        if kind == "css":
            # css may reference more assets; handled on rewrite via local_map
            pass
        with open(dest, "wb") as f:
            f.write(data)
        return dest, len(data)

    # ----- main crawl -----
    def rip(self):
        from collections import deque
        queue = deque([(norm_url(self.start_url), 0)])
        self.seen.add(norm_url(self.start_url))
        t0 = time.time()

        with concurrent.futures.ThreadPoolExecutor(
                max_workers=self.threads) as pool:
            while queue and self.stats["pages"] < self.max_pages:
                url, depth = queue.popleft()
                if depth > self.max_depth:
                    continue
                if not self._allowed(url):
                    self.stats["skipped_robots"] += 1
                    continue
                self.say(f"\n{C}[→]{RS} {D}{url}{RS}")
                r = fetch(url)
                if not r["ok"]:
                    log_warn(f"skip ({r.get('status')}: {r.get('error', '?')})")
                    continue
                ct = r["ct"].lower()
                if "html" not in ct and "text" not in ct:
                    log_warn(f"skip (not HTML: {ct or 'unknown type'})")
                    continue

                parser = PageParser(r["url"])
                try:
                    parser.feed(r["text"])
                except Exception as e:
                    log_warn(f"parse issue: {e}")

                # download this page's assets in parallel
                futures = {pool.submit(self.download_asset, u, k): (u, k)
                           for u, k in parser.assets.items()}
                page_file = self.page_path(r["url"])
                os.makedirs(os.path.dirname(page_file), exist_ok=True)
                page_dir = os.path.dirname(page_file)
                local_map = {}
                for fut in concurrent.futures.as_completed(futures):
                    u, k = futures[fut]
                    try:
                        dest, size = fut.result()
                    except Exception:
                        dest, size = None, 0
                    if dest:
                        rel = os.path.relpath(dest, page_dir)
                        local_map[u] = rel
                        with self.lock:
                            self.stats["assets"] += 1
                            self.stats["bytes"] += size
                            kinds = self.stats["kinds"]
                            kinds[k] = kinds.get(k, 0) + 1

                # rewrite css files that reference local assets
                for u, rel in list(local_map.items()):
                    if rel.endswith(".css"):
                        css_file = os.path.join(page_dir, rel)
                        try:
                            with open(css_file, "r", encoding="utf-8",
                                      errors="replace") as f:
                                css_text = f.read()
                            new_css = rewrite_css(css_text, u, local_map)
                            if new_css != css_text:
                                with open(css_file, "w",
                                          encoding="utf-8") as f:
                                    f.write(new_css)
                        except Exception:
                            pass

                html_out = rewrite_html(r["text"], r["url"], local_map)
                with open(page_file, "w", encoding="utf-8") as f:
                    f.write(html_out)
                self.stats["pages"] += 1
                self.stats["forms"] += len(parser.forms)
                log_ok(f"saved {os.path.relpath(page_file, self.out_dir)} "
                       f"({len(local_map)} assets)")

                if parser.forms and not self.quiet:
                    for fm in parser.forms:
                        names = [i["name"] or i["type"]
                                 for i in fm["inputs"]][:6]
                        log_info(f"form: {fm['method']} {fm['action'] or '(same page)'} "
                                 f"fields={names}")

                # enqueue same-host page links
                if depth < self.max_depth:
                    for link in parser.page_links:
                        if not is_http(link):
                            continue
                        if urllib.parse.urlparse(link).netloc != self.host:
                            continue
                        ext = os.path.splitext(
                            urllib.parse.urlparse(link).path)[1].lower()
                        if ext and ext not in (".html", ".htm", ".php",
                                               ".asp", ".aspx", ".jsp"):
                            continue  # file, not a page
                        if not self._allowed(link):
                            self.stats["skipped_robots"] += 1
                            continue
                        with self.lock:
                            if link not in self.seen:
                                self.seen.add(link)
                                queue.append((link, depth + 1))

        dt = time.time() - t0
        self.report(dt)

    def report(self, dt):
        mb = self.stats["bytes"] / (1024 * 1024)
        kinds = self.stats.get("kinds", {})
        images = kinds.get("images", 0)
        css = kinds.get("css", 0)
        js = kinds.get("js", 0)
        fonts = kinds.get("fonts", 0)
        media = kinds.get("media", 0)
        other = kinds.get("other", 0)
        print(f"\n{G}╔══ RIP COMPLETE ══════════════════════════════╗{RS}")
        print(f"{G}║{RS}  Pages saved : {W}{self.stats['pages']}{RS} (HTML code)")
        print(f"{G}║{RS}  CSS files   : {W}{css}{RS}")
        print(f"{G}║{RS}  JS files    : {W}{js}{RS}")
        print(f"{G}║{RS}  Images      : {W}{images}{RS}")
        if fonts or media or other:
            print(f"{G}║{RS}  Fonts/Media : {W}{fonts + media + other}{RS}")
        print(f"{G}║{RS}  Assets total: {W}{self.stats['assets']}{RS}")
        print(f"{G}║{RS}  Total size  : {W}{mb:.2f} MB{RS}")
        print(f"{G}║{RS}  Forms found : {W}{self.stats['forms']}{RS} (info only)")
        print(f"{G}║{RS}  Time        : {W}{dt:.1f}s{RS}")
        print(f"{G}║{RS}  Output      : {W}{self.out_dir}{RS}")
        print(f"{G}╚══════════════════════════════════════════════╝{RS}")
        print(f"{D}Open {os.path.join(self.out_dir, 'site', 'index.html')} "
              f"to browse offline.{RS}\n")


def main():
    ap = argparse.ArgumentParser(
        prog="v4zrip",
        description="V4Z Web Ripper — download a website's public source "
                    "and assets for offline study (educational use only).")
    ap.add_argument("url", nargs="?", default=None,
                    help="website URL to rip, e.g. https://example.com "
                         "(omit to open the interactive menu)")
    ap.add_argument("-d", "--depth", type=int, default=1,
                    help="crawl depth, 0 = single page (default: 1)")
    ap.add_argument("-p", "--max-pages", type=int, default=20,
                    help="max pages to save (default: 20)")
    ap.add_argument("-o", "--output", default=None,
                    help="output folder (default: ./<host>_rip)")
    ap.add_argument("-t", "--threads", type=int, default=8,
                    help="download threads (default: 8)")
    ap.add_argument("-q", "--quiet", action="store_true",
                    help="less output")
    ap.add_argument("--single", action="store_true",
                    help="single page only (same as -d 0 -p 1)")
    ap.add_argument("-v", "--version", action="version",
                    version=f"%(prog)s {VERSION}")
    args = ap.parse_args()

    interactive = False
    if not args.url:
        # ---- interactive menu: just run `v4zrip` ----
        interactive = True
        if not args.quiet:
            banner()
        try:
            print(f"\n{C}[?]{RS} {W}Enter the website link:{RS}")
            link = input(f"    {G}Link:{RS} ").strip()
            if not link:
                log_err("No link given. Bye!")
                sys.exit(1)
            print(f"\n{C}[?]{RS} {W}What should I rip?{RS}")
            print(f"    {G}[1]{RS} Full site (all pages, same domain)")
            print(f"    {G}[2]{RS} Single page only")
            choice = input(f"    {G}Choose [1/2]:{RS} ").strip()
        except EOFError:
            log_err("No input. Give a link: v4zrip https://example.com")
            sys.exit(1)
        args.url = link
        args.single = (choice == "2")
        print("")

    url = args.url.strip()
    if not re.match(r"^https?://", url, re.I):
        url = "https://" + url
    if not is_http(url):
        log_err("URL must start with http:// or https://")
        sys.exit(1)

    host = urllib.parse.urlparse(url).netloc
    if args.output:
        out_dir = args.output
    else:
        folder = f"{host}_rip".replace(":", "_")
        downloads = os.path.expanduser("~/storage/downloads")
        if os.path.isdir(downloads):
            out_dir = os.path.join(downloads, "V4Z-Rips", folder)
        else:
            out_dir = folder
    os.makedirs(out_dir, exist_ok=True)

    depth = 0 if args.single else args.depth
    max_pages = 1 if args.single else args.max_pages

    if not args.quiet and not interactive:
        banner()
    log_info(f"target : {url}")
    log_info(f"output : {out_dir}")
    log_info(f"depth  : {depth}, max pages: {max_pages}")

    try:
        Ripper(url, out_dir, max_depth=depth,
               max_pages=max_pages, threads=args.threads,
               quiet=args.quiet).rip()
    except KeyboardInterrupt:
        print(f"\n{Y}[!]{RS} stopped by user — partial results kept in {out_dir}")
        sys.exit(130)


if __name__ == "__main__":
    main()
